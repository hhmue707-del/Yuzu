# ===== REQUIRED =====
# From @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=9170989014:AAFx7k7pVb2uxRYLgtxf9mFSQWfdxGTpdXc
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ===== ADMINS =====
# Your numeric Telegram user ID(s), comma separated (get it from @userinfobot).
# Telegram group admins can always use /ai and /clear in their own group anyway.
ADMIN_IDS=8837432063,6646491795

# ===== OPTIONAL =====
# Only work in these chat IDs (comma separated). Empty = any group the bot is in.
ALLOWED_CHAT_IDS=

# Models tried in order. If one hits its free quota, the next is used.
# Model names change over time: see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash-lite
# Reply delay (seconds, random between min and max)
REPLY_DELAY_MIN=0
REPLY_DELAY_MAX=0

# Cooldowns (seconds)
USER_COOLDOWN_SECONDS=2
CHAT_COOLDOWN_SECONDS=1

# Free-tier protection: max Gemini requests per minute the bot will ever send
MAX_GEMINI_REQUESTS_PER_MINUTE=10

# Conversation memory (messages kept per chat) and queue size per chat
MAX_HISTORY_MESSAGES=12
MAX_PENDING_PER_CHAT=5

# Reply length cap (characters) and creativity (0.0 - 2.0)
MAX_REPLY_CHARS=120
TEMPERATURE=0.8
# Let the bot also answer in private chat (handy for testing)
ALLOW_PRIVATE_CHATS=true
# Auto-reply ON for chats seen for the first time
AI_ENABLED_BY_DEFAULT=true

PERSONA_NAME=Yuzu
STATE_FILE=state.json
LOG_LEVEL=INFO

# Stickers (0 = never, 1 = always)
STICKER_CHANCE=1
STICKER_REPLY_CHANCE=1

# Extra Gemini keys (comma separated, no spaces). Used after GEMINI_API_KEY runs out.
GEMINI_API_KEYS=
STICKER_EVERY=2

# Creator name the bot gives when asked who made it
CREATOR_HANDLE=@DeanOfc
# DM gate: users must join this channel before chatting (@channelname or -100...). Empty = off.
# The bot must be an ADMIN of this channel.
REQUIRED_CHANNEL=@RezeShopChannel
# Optional invite link for the Join button (needed for private channels)
CHANNEL_LINK=https://t.me/RezeShopChannel
# Owner Telegram ID(s) the bot is extra respectful to. Empty = same as ADMIN_IDS
OWNER_IDS=8837432063,6646491795

# Forward/link guard (true/false)
FORWARD_GUARD=true
# Strikes before a mute, and mute length in hours (0 = until an admin unmutes)
MAX_STRIKES=3
MUTE_HOURS=24
# Leave message (true/false)
LEAVE_MESSAGE=true
# Optional: use your own direct image links (https://i.ibb.co/...jpg). Empty = built-in images
WARN_IMAGE_URL=https://ibb.co/TMd3vPqL
LEAVE_IMAGE_URL=https://ibb.co/Cs8LzzhK

# Starting mode for new chats: friend | love | funny | sad
DEFAULT_MODE=love

ANTI_BOT=true
ALL_MAX=200
ALL_DELAY=2

# --- extras ---
ANTI_FLOOD=true
FLOOD_MAX=7
FLOOD_SECONDS=8
FLOOD_MUTE_MINUTES=10
BADWORDS=true
USER_MEMORY=true
USER_MEMORY_EVERY=20
PHOTO_REPLY=false
PHOTO_REPLY_CHANCE=0.25
GREETING=true
GREET_MORNING_HOUR=7
GREET_NIGHT_HOUR=22
TZ_OFFSET_HOURS=6.5
GREET_ACTIVE_DAYS=3

# Group people must ALSO join before DM chat (@groupname or -100...). Empty = channel only.
# The bot must be admin in that group.
REQUIRED_GROUP=@RezeFamily
GROUP_LINK=
# Bot username used by the Add To Group button (without @)
BOT_USERNAME=ImYuzuAutoReplyBot

# --- share / backup ---
# GitHub auto-backup of the bot data. Use a PRIVATE repo. Token = fine-grained token with
# Contents: Read and write on that repo. Never put the token in the code or in the repo.
GITHUB_TOKEN=
GITHUB_REPO=hhmue707-del/Yuzu
GITHUB_BRANCH=bot-data
GITHUB_DATA_PATH=data/alldata.json
DAILY_REPORT=true
DAILY_REPORT_HOUR=0
SHARE_DELAY=0.1
